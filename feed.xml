---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.data.profile.name | xml_escape }} — Posts</title>
  <link href="{{ '/feed.xml' | absolute_url | xml_escape }}" rel="self"/>
  <link href="{{ '/' | absolute_url | xml_escape }}"/>
  <id>{{ '/' | absolute_url | xml_escape }}</id>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author><name>{{ site.data.profile.name | xml_escape }}</name></author>
  {% for post in site.posts limit:20 %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <link href="{{ post.url | absolute_url | xml_escape }}"/>
    <id>{{ post.url | absolute_url | xml_escape }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.updated | default: post.date | date_to_xmlschema }}</updated>
    <summary>{{ post.description | default: post.excerpt | strip_html | xml_escape }}</summary>
  </entry>
  {% endfor %}
</feed>
